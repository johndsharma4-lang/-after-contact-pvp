{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "after-contact-pvp",
  "main": "index.js",
  "compatibility_date": "2026-08-14",
  "durable_objects": {
    "bindings": [
      {
        "name": "MY_DURABLE_OBJECT",
        "class_name": "MyDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MyDurableObject"
      ]
    }
  ]
}
